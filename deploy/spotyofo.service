[Unit]
Description=SpotyOFO
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=ofo
Group=ofo
WorkingDirectory=/var/www/spotyofo
EnvironmentFile=/etc/spotyofo.env
ExecStart=/var/www/spotyofo/.venv/bin/gunicorn --bind 127.0.0.1:5050 --workers 1 --threads 8 --timeout 120 app:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
