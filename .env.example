# Copia este archivo a .env. No subas .env a Git.
# Desarrollo (PC ofo): SPOTY_ENV=local y SPOTY_TRUST_PROXY=0
# Producción (ofoserv): lo escribe /etc/spotyofo.env, no este archivo.

SPOTY_ENV=local
SPOTY_DB_HOST=127.0.0.1
SPOTY_DB_PORT=3306
SPOTY_DB_USER=spotyofo
SPOTY_DB_PASSWORD=
SPOTY_DB_NAME=spotyofo
SPOTY_HOST=0.0.0.0
SPOTY_PORT=5050
SPOTY_TRUST_PROXY=0
# Carpeta Música. Vacío usa la carpeta del sistema (Windows o ~/Music).
SPOTY_MUSIC_ROOT=

# Cuenta demo (portafolio). Ver demo.py y «python manage.py demo-reset».
# La contraseña nunca va en Git: en ofoserv va en /etc/spotyofo.env.
SPOTY_DEMO_USER=demo
SPOTY_DEMO_PASSWORD=
# 1 = botón «Probar demo» en la página de ingreso (entra sin escribir la contraseña).
SPOTY_DEMO_ENABLED=0
